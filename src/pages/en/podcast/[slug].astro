---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { en } from '../../../i18n/en';
import { localePath } from '../../../i18n';
import { getShows, getEpisodes } from '../../../lib/podcast';

export async function getStaticPaths() {
  const shows = await getShows('en');
  return shows.map((show) => ({
    params: { slug: show.id },
    props: { show },
  }));
}

const { show } = Astro.props;
const episodes = await getEpisodes('en', show.id);

const dateFmt = new Intl.DateTimeFormat('en-US', { day: '2-digit', month: 'short', year: 'numeric' });
const epLabel = (n: number) => en.podcast.episode.replace('{n}', String(n).padStart(2, '0'));
---

<BaseLayout locale="en" t={en} title={show.data.title} description={show.data.description}>
  <section class="border-b border-base-300">
    <div class="max-w-[760px] mx-auto px-6 py-[72px]">
      <a href={localePath('en', '/podcast')} class="font-mono text-xs text-base-content/60 hover:text-primary transition-colors">
        ← {en.nav.podcast}
      </a>
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl mt-6 mb-4 leading-tight">
        {show.data.title}
      </h1>
      <p class="text-base-content/70 text-lg max-w-2xl mb-8">{show.data.description}</p>

      {(show.data.youtube || show.data.spotify) && (
        <div class="flex flex-wrap items-center gap-3 mb-10">
          <span class="font-mono text-[11px] text-primary">{en.podcast.subscribe}</span>
          {show.data.youtube && (
            <a href={show.data.youtube} class="inline-flex items-center gap-2 border border-base-300 px-3 py-2 text-sm hover:border-primary transition-colors">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-primary">
                <rect x="2" y="6" width="14" height="12" rx="2" />
                <path d="m22 10-6 4-6-4" />
              </svg>
              YouTube
            </a>
          )}
          {show.data.spotify && (
            <a href={show.data.spotify} class="inline-flex items-center gap-2 border border-base-300 px-3 py-2 text-sm hover:border-primary transition-colors">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-primary">
                <circle cx="8" cy="18" r="3" />
                <path d="M11 18V5l9-2v13" />
                <circle cx="17" cy="16" r="3" />
              </svg>
              Spotify
            </a>
          )}
        </div>
      )}

      {episodes.length === 0 ? (
        <div class="border border-dashed border-base-300 p-6 text-base-content/60">
          {en.podcast.emptyEpisodes}
        </div>
      ) : (
        <div class="border-t border-base-300">
          {episodes.map((ep) => {
            const href = ep.data.youtubeId
              ? `https://www.youtube.com/watch?v=${ep.data.youtubeId}`
              : ep.data.spotifyUrl;
            const meta = [dateFmt.format(ep.data.publishDate), ep.data.duration, ep.data.youtubeId ? 'YouTube' : null, ep.data.spotifyUrl ? 'Spotify' : null]
              .filter(Boolean)
              .join(' · ');
            const inner = (
              <>
                <span class="font-mono text-xs text-primary w-16 shrink-0">{epLabel(ep.data.number)}</span>
                <span class="min-w-0 flex-1">
                  <span class="block text-base font-medium text-base-content">{ep.data.title}</span>
                  <span class="block font-mono text-[11px] text-base-content/50 mt-0.5">{meta}</span>
                </span>
                <span class="w-9 h-9 shrink-0 border border-base-300 flex items-center justify-center text-primary">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                    <polygon points="6321212119" />
                  </svg>
                </span>
              </>
            );
            return href ? (
              <a href={href} class="flex items-center gap-4 py-4 border-b border-base-300 group">
                {inner}
              </a>
            ) : (
              <div class="flex items-center gap-4 py-4 border-b border-base-300">{inner}</div>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
