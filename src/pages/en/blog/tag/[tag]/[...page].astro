---
import type { PaginateFunction } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Section from '../../../../../components/Section.astro';
import BlogList from '../../../../../components/BlogList.astro';
import { en } from '../../../../../i18n/en';

export const POSTS_PER_PAGE = 5;

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const all = await getCollection('postsEn');
  const tags = [...new Set(all.flatMap((p) => p.data.tags))].filter((t) => t !== 'en');

  return tags.flatMap((tag) => {
    const filtered = all
      .filter((p) => p.data.tags.includes(tag))
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
    return paginate(filtered, { pageSize: POSTS_PER_PAGE, params: { tag } });
  });
}

const { page } = Astro.props;
const { tag } = Astro.params;
---

<BaseLayout locale="en" t={en} title={`${tag} · blog`} description={en.meta.blogDescription}>
  <Section id="blog" title={en.blog.title} sub={`// blog · ${tag} tagged posts`}>
    <p class="text-xl text-base-content/70 max-w-2xl">
      <a href="/en/blog" class="text-primary hover:underline">{en.blog.allPosts}</a> · "{tag}" {en.blog.tagLead}
    </p>
  </Section>
  <BlogList page={page} locale="en" t={en} activeTag={tag} />
</BaseLayout>
