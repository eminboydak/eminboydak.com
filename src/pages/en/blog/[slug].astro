---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Badge from '../../../components/Badge.astro';
import { en } from '../../../i18n/en';
import { getSeriesContext } from '../../../lib/series';

export async function getStaticPaths() {
  const posts = await getCollection('postsEn');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const seriesCtx = await getSeriesContext('en', post);

const dateStr = [
  new Intl.DateTimeFormat('en-US', { day: '2-digit' }).format(post.data.publishDate),
  new Intl.DateTimeFormat('en-US', { month: 'short' }).format(post.data.publishDate),
  new Intl.DateTimeFormat('en-US', { year: 'numeric' }).format(post.data.publishDate),
].join(' ');
---

<BaseLayout locale="en" t={en} title={post.data.title} description={post.data.description}>
  <section class="border-b border-base-300">
    <div class="max-w-[760px] mx-auto px-6 py-[72px]">
      <a href="/en/blog" class="font-mono text-xs text-base-content/60 hover:text-primary transition-colors">
        {en.blog.back}
      </a>
      <h1 class="font-display font-extrabold text-4xl md:text-5xl mt-6 mb-4 leading-tight">
        {post.data.title}
      </h1>
      <div class="flex flex-wrap items-center gap-3 mb-10">
        <span class="font-mono text-xs text-base-content/60">{dateStr}</span>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.filter((t) => t !== 'en').map((t) => (
            <Badge>{t}</Badge>
          ))}
        </div>
      </div>
      {seriesCtx && (
        <div data-series-banner class="border border-base-300 bg-base-200 p-4 mb-10 flex flex-wrap items-center justify-between gap-4">
          <div>
            <div class="font-mono text-[11px] text-primary">
              {en.series.partOf
                .replace('{title}', seriesCtx.series.data.title)
                .replace('{n}', String(post.data.part ?? ''))}
            </div>
            <div class="text-sm text-base-content/70 mt-1">
              {seriesCtx.prev ? `${en.series.prev}: ${seriesCtx.prev.data.title}` : ''}
              {seriesCtx.prev && seriesCtx.next ? ' · ' : ''}
              {seriesCtx.next ? `${en.series.next}: ${seriesCtx.next.data.title}` : ''}
            </div>
          </div>
          <div class="flex flex-wrap gap-5 text-sm">
            {seriesCtx.prev && (
              <a
                href={`/en/blog/${seriesCtx.prev.id}`}
                class="inline-flex items-center gap-1.5 text-base-content/70 hover:text-primary transition-colors"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M19 12H5" /><path d="m12 19-7-7 7-7" />
                </svg>
                {en.series.prev}
              </a>
            )}
            {seriesCtx.next && (
              <a
                href={`/en/blog/${seriesCtx.next.id}`}
                class="inline-flex items-center gap-1.5 text-base-content/70 hover:text-primary transition-colors"
              >
                {en.series.next}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            )}
          </div>
        </div>
      )}
      <div class="prose prose-invert prose-lg max-w-none font-body">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>
