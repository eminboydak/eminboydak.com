---
import type { PaginateFunction } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Section from '../../../../components/Section.astro';
import BlogList from '../../../../components/BlogList.astro';
import { tr } from '../../../../i18n/tr';

export const POSTS_PER_PAGE = 5;

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const all = await getCollection('postsTr');
  const tags = [...new Set(all.flatMap((p) => p.data.tags))].filter((t) => t !== 'tr');

  return tags.flatMap((tag) => {
    const filtered = all
      .filter((p) => p.data.tags.includes(tag))
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
    return paginate(filtered, { pageSize: POSTS_PER_PAGE, params: { tag } });
  });
}

const { page } = Astro.props;
const { tag } = Astro.params;
---

<BaseLayout locale="tr" t={tr} title={`${tag} · blog`} description={tr.meta.blogDescription}>
  <Section id="blog" title={tr.blog.title} sub={`// blog · ${tag} etiketli yazılar`}>
    <p class="text-xl text-base-content/70 max-w-2xl">
      <a href="/blog" class="text-primary hover:underline">{tr.blog.allPosts}</a> · "{tag}" {tr.blog.tagLead}
    </p>
  </Section>
  <BlogList page={page} locale="tr" t={tr} activeTag={tag} />
</BaseLayout>
